@using FamilieLaissFrontend.Client.Layout

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["css/UploadPictureContainer.css"]" />
    <link rel="stylesheet" href="@Assets["css/PictureControl.css"]" />
    <link rel="stylesheet" href="@Assets["css/VideoControl.css"]" />
    <link rel="stylesheet" href="@Assets["css/UploadVideoContainer.css"]" />
    <link rel="stylesheet" href="@Assets["css/MediaContainer.css"]" />
    <link rel="stylesheet" href="@Assets["videojs/skins/chrome/videojs.min.css"]">
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link href="@Assets["_content/CodeBeam.MudBlazor.Extensions/MudExtensions.min.css"]" rel="stylesheet" />
    <HeadOutlet @rendermode="RenderModeForPage" />
    <ImportMap />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <script src="@Assets["videojs/video.min.js"]"></script>
    <script src="@Assets["videojs/plugins/videojs.thumbnails.js"]"></script>
    <script src="@Assets["videojs/nuevo.min.js"]"></script>
    <script src="@Assets["videojs/lang/en.js"]"></script>
    <script src="@Assets["videojs/lang/de.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_content/CodeBeam.MudBlazor.Extensions/MudExtensions.min.js"]"></script>
    <script src="@Assets["_content/Radzen.Blazor/Radzen.Blazor.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InteractiveAutoRenderMode interactiveAutoRenderMode = new(prerender: true);

    private IComponentRenderMode? RenderModeForPage => interactiveAutoRenderMode;
}
