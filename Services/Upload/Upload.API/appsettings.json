{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Using": [],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "Application": "Upload.API"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "OpenTelemetry"
      }
    ]
  },
  "AppSettings": {
    "DirectoryUploadPicture": "UploadPicture",
    "DirectoryUploadPortrait": "/var/lib/familielaiss/Content/Portrait",
    "DirectoryUploadVideo": "/var/lib/familielaiss/Content/Video",
    "TempDirectoryUploadPicture": "TempUploadPicture",
    "TempDirectoryUploadPortrait": "/var/lib/familielaiss/Content/TempUploadPortrait",
    "TempDirectoryUploadVideo": "/var/lib/familielaiss/Content/TempUploadVideo",
    "GoogleMicroserviceVersion": "v1",
    "EndpointUploadService": "upload-service",
    "CardSizeWidth": 220,
    "CardSizeHeight": 165,
    "GallerySizeWidth": 800,
    "GallerySizeHeight": 600,
    "ThumbnailSizeWidth": 100,
    "ThumbnailSizeHeight": 75
  }
}
